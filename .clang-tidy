---
# llvm-include-order enforces LLVM's own ordering, which contradicts the project's
# .clang-format rules; clang-format is the single authority on include order here.
#
# The trailing group disables checks for constructs this project cannot contain. They match
# nothing, so they only cost time scanning the standard library and the Cube headers:
#   string_view, coroutines, Objective-C, GoogleTest, the LLVM internal APIs, std::bind,
#   iostreams, std::auto_ptr and std::random_shuffle (both removed in C++17), and printf.
# It also drops clang-analyzer-core.FixedAddressDereference, which every memory mapped
# peripheral access looks like by construction.
Checks:
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-dynamic-static-initializers,
  -bugprone-bitwise-pointer-cast,
  clang-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-pro-type-union-access,
  google-*,
  llvm-*,
  -llvm-header-guard,
  -llvm-include-order,
  misc-*,
  -misc-use-anonymous-namespace,
  modernize-*,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  performance-*,
  readability-*,
  -readability-duplicate-include,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -bugprone-stringview-nullptr,
  -cppcoreguidelines-no-suspend-with-lock,
  -google-objc-*,
  -google-upgrade-googletest-case,
  -llvm-prefer-isa-or-dyn-cast-in-conditionals,
  -llvm-prefer-register-over-unsigned,
  -llvm-twine-local,
  -modernize-avoid-bind,
  -modernize-deprecated-ios-base-aliases,
  -modernize-replace-auto-ptr,
  -modernize-replace-random-shuffle,
  -modernize-use-std-print,
  -clang-analyzer-core.FixedAddressDereference,
HeaderFileExtensions:
  - ''
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: '(include|config)/.*\.hpp$'
FormatStyle: file
CheckOptions:
  # The vendor HAL module headers are not standalone; they require stm32<family>xx_hal.h to have
  # pulled in stm32<family>xx_hal_def.h first, so include-cleaner must not suggest or remove them.
  # This is why micras_hal includes the generated main.h, which reaches the right one for the
  # family it was generated for, instead of naming a module header of its own. main.h is on the
  # list for the same reason: every symbol behind it resolves to a header already listed here, so
  # nothing is credited to main.h and it would otherwise be reported as unused.
  misc-include-cleaner.IgnoreHeaders: 'stm32.*;core_cm.*;cmsis.*;system_stm32.*;lsm6dsv.*;main\.h'
  readability-identifier-length.MinimumVariableNameLength: 2
  readability-identifier-length.IgnoredVariableNames: ^[nxyz]$
  readability-identifier-length.MinimumParameterNameLength: 2
  readability-identifier-length.IgnoredParameterNames: ^[nxyz]$
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: false
SystemHeaders: false
...
