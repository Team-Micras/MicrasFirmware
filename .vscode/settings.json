{
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,

    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    "files.encoding": "utf8",

    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",

    // clangd owns IntelliSense; cpptools is kept only for its debugging integration.
    // --query-driver lets clangd ask the cross compiler for its own system include paths,
    // instead of having them hardcoded for one toolchain version.
    "clangd.arguments": [
        "--query-driver=/usr/bin/arm-none-eabi-*",
        "--header-insertion=never",
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autoAddFileAssociations": false,

    "doxdocgen.file.fileOrder": [
        "file",
    ]
}
