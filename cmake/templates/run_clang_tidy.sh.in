#!/bin/bash

# Positional arguments are the source files to check; they are passed to run-clang-tidy as
# path regexes matched against the entries of the compilation database.

RUN_FLAGS=()

if [[ "${1:-}" == "--fix" ]]; then
    RUN_FLAGS+=(-fix -format)
    shift
fi

if [[ -t 1 ]]; then
    RUN_FLAGS+=(-use-color)
fi

# Unknown check names are silently ignored during a normal run, so the configuration is
# validated explicitly to keep it from rotting across clang-tidy versions.
clang-tidy --verify-config || exit 1

echo "Running clang-tidy on all source files..."

# run-clang-tidy bounds the number of concurrent clang-tidy processes, unlike a plain
# background job per file, and serializes the fixes it applies to shared headers.
# The filtered lines are the echoed clang-tidy invocations and the per-file diagnostic
# counters, which include the warnings suppressed in the Cube headers and are always noise.
# Real diagnostics name their own file, so nothing useful is hidden.
run-clang-tidy \
    "${RUN_FLAGS[@]}" \
    -quiet \
    -j "$(nproc)" \
    -warnings-as-errors="*" \
    -p @CMAKE_CURRENT_BINARY_DIR@ \
    -extra-arg-before=-Wno-unknown-warning-option \
    -extra-arg-before=--sysroot=@SYSROOT@/ \
    -extra-arg-before=-I@CXX_INCLUDE_DIR@/ \
    -extra-arg-before=-I@CXX_TRIPLE_INCLUDE_DIR@/ \
    "$@" 2>&1 | grep -Ev '^(\[ *[0-9]+/[0-9]+\]|[0-9]+ (warning|error)s? generated\.|clang-tidy(-[0-9.]+)? )'

exit "${PIPESTATUS[0]}"
