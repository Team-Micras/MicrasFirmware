#!/bin/bash

# Positional arguments are the source files to check; they are passed to run-clang-tidy as
# path regexes matched against the entries of the compilation database.
#
# The canonical copy lives in micras-lib; micras-simulation and MicrasFirmware carry the same file
# byte for byte. Each repository configures it with the clang tools it found by their versioned
# names and with the extra arguments its compiler needs (the ARM sysroot on the robot, none on the
# host), one argument per line in MICRAS_TIDY_EXTRA_ARGS.

CLANG_TIDY="@MICRAS_CLANG_TIDY@"
RUN_CLANG_TIDY="@MICRAS_RUN_CLANG_TIDY@"
CLANG_APPLY_REPLACEMENTS="@MICRAS_CLANG_APPLY_REPLACEMENTS@"

mapfile -t EXTRA_ARGS <<'EXTRA_ARGS_END'
@MICRAS_TIDY_EXTRA_ARGS@
EXTRA_ARGS_END

RUN_FLAGS=(-clang-tidy-binary "${CLANG_TIDY}")

for ARG in "${EXTRA_ARGS[@]}"; do
    if [[ -n "${ARG}" ]]; then
        RUN_FLAGS+=("-extra-arg-before=${ARG}")
    fi
done

if [[ "${1:-}" == "--fix" ]]; then
    RUN_FLAGS+=(-fix -format -clang-apply-replacements-binary "${CLANG_APPLY_REPLACEMENTS}")
    shift
fi

if [[ -t 1 ]]; then
    RUN_FLAGS+=(-use-color)
fi

# Unknown check names are silently ignored during a normal run, so the configuration is
# validated explicitly to keep it from rotting across clang-tidy versions.
"${CLANG_TIDY}" --verify-config || exit 1

echo "Running clang-tidy on all source files..."

# run-clang-tidy bounds the number of concurrent clang-tidy processes, unlike a plain
# background job per file, and serializes the fixes it applies to shared headers.
# The filtered lines are the echoed clang-tidy invocations and the per-file diagnostic
# counters, which include the warnings suppressed in the vendor headers and are always noise.
# Real diagnostics name their own file, so nothing useful is hidden.
# The turn tables are designed as a constant expression wherever a program compiles them, which
# takes more evaluation steps than clang allows by default.
"${RUN_CLANG_TIDY}" \
    "${RUN_FLAGS[@]}" \
    -quiet \
    -j "$(nproc)" \
    -warnings-as-errors="*" \
    -p "@CMAKE_BINARY_DIR@" \
    -extra-arg-before=-Wno-unknown-warning-option \
    -extra-arg=-fconstexpr-steps=1000000000 \
    "$@" 2>&1 | grep -Ev '^(\[ *[0-9]+/[0-9]+\]|[0-9]+ (warning|error)s? generated\.|clang-tidy(-[0-9.]+)? )'

exit "${PIPESTATUS[0]}"
