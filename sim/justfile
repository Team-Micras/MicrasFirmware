# Recipes of the Micras target, run from this directory: `just micras <recipe>` from
# the repository root. Paths below are relative to targets/micras.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments := true

root := source_directory() / ".." / ".."
micras_preset := env("MICRAS_PRESET", "default")
build_root := root / "build" / micras_preset
bin := build_root / "targets/micras/micras_sim"
calibration := build_root / "targets/micras/micras_wall_calibration"
robot_report := build_root / "targets/micras/micras_robot_report"
turn_designer := build_root / "targets/micras/micras_turn_designer"
python := "python3"
tools := root / "tools"
free_port := python + " -c 'import socket; s = socket.socket(); s.bind((\"127.0.0.1\", 0)); print(s.getsockname()[1])'"

# The current baseline version: one summary per checked run (tools/baseline.py).
baseline := "baselines/v5"
check_runs := "idle explore"
# The checked explore is the first 30 s of the scenario: out of the start cell, the
# first corridors, turns and front walls. The whole scenario takes three minutes.
explore_seconds := "30"

default:
    @just --list

# Configure if needed, then build everything.
build:
    test -f {{build_root}}/CMakeCache.txt || (cd {{root}} && cmake --preset {{micras_preset}})
    cmake --build {{build_root}}

# The Micras unit tests through CTest.
test: build
    ctest --test-dir {{build_root}}/targets/micras --output-on-failure

# Run the firmware with arbitrary simulator flags, e.g. `just micras run --scenario scenarios/explore.toml --out runs/x`.
run *args: build
    {{bin}} "$@"

# The robot left alone for 4 s -> runs/idle
run-idle: build
    {{bin}} --scenario scenarios/idle.toml --out runs/idle

# The first 30 s of an exploration started by the button -> runs/explore
run-explore: build
    {{bin}} --scenario scenarios/explore.toml --seconds {{explore_seconds}} --out runs/explore

# Plots and report.json for one run directory.
analyze run:
    {{python}} {{tools}}/analyze.py "$1"

# Each wall sensor's gain for robot.toml, or with --sweep how the firmware's distances follow the true ones.
wall-calibration *args: build
    {{calibration}} "$@"

# robot.toml, the physical description, against robot.hpp, the firmware's belief, field by field.
robot-report: build
    {{robot_report}}

# Design the turns of two bends and rewrite the firmware's config/two_bend_turns.hpp.
turn-designs: build
    {{turn_designer}} > MicrasFirmware/config/two_bend_turns.hpp.new
    mv MicrasFirmware/config/two_bend_turns.hpp.new MicrasFirmware/config/two_bend_turns.hpp

# Run with the bridge open so micras-monitor can connect on ws://localhost:8080.
serve *args: build
    {{bin}} --scenario scenarios/explore_link.toml --out runs/serve --monitor "$@"

# Watch a run in a window. Space pauses, right steps, tab cycles cameras, esc quits.
watch *args: build
    {{bin}} --scenario scenarios/explore.toml --out runs/watch --viewer "$@"

# 100 s explore recorded offscreen, then analysed.
video: build
    {{bin}} --scenario scenarios/explore.toml --seconds 100 --out runs/video \
        --video runs/video/explore.mp4 --video-fps 30 --video-size 1280x720
    {{python}} {{tools}}/analyze.py runs/video

# Compare the checked runs against the recorded baseline summaries.
compare-baseline:
    for run in {{check_runs}}; do {{python}} {{tools}}/baseline.py compare runs/$run {{baseline}}/$run; done

# Refuses to overwrite a version, so an older one is never lost: bump it instead.
# Record a new baseline version from the checked runs.
record-baseline: test run-idle run-explore
    for run in {{check_runs}}; do {{python}} {{tools}}/baseline.py record runs/$run {{baseline}}/$run; done

# A bridged run with nobody connected must match the same run without it, and the
# bridge must actually have listened.
# Prove the monitor bridge changes nothing.
check-monitor: build
    mkdir -p runs/monitor
    {{bin}} --scenario scenarios/explore.toml --seconds 6 --out runs/monitor/plain > /dev/null
    port=$({{free_port}}); \
        {{bin}} --scenario scenarios/explore.toml --seconds 6 --out runs/monitor/quiet --monitor \
            --monitor-port $port > runs/monitor/quiet.log; \
        grep -q "monitor bridge listening" runs/monitor/quiet.log
    {{python}} {{tools}}/compare_run.py runs/monitor/quiet runs/monitor/plain

# The same scenario headless and watched must agree. Fails when there is no display
# and no xvfb-run, unless MICRAS_SKIP_VIEWER=1 says so.
# Prove a window changes nothing.
check-viewer: build
    if command -v xvfb-run > /dev/null; then \
        show="xvfb-run -a"; \
    elif [ -n "${DISPLAY:-}" ]; then \
        show=""; \
    elif [ "${MICRAS_SKIP_VIEWER:-0}" = 1 ]; then \
        echo "MICRAS_SKIP_VIEWER=1: skipping the viewer comparison"; \
        exit 0; \
    else \
        echo "no display and no xvfb-run; install xvfb or set MICRAS_SKIP_VIEWER=1"; \
        exit 1; \
    fi; \
    {{bin}} --scenario scenarios/explore.toml --seconds 3 --out runs/viewer/headless > /dev/null; \
    $show {{bin}} --scenario scenarios/explore.toml --seconds 3 --out runs/viewer/watched \
        --viewer --viewer-size 640x480 > /dev/null; \
    {{python}} {{tools}}/compare_run.py runs/viewer/watched runs/viewer/headless

# The same scenario with and without --video must agree. Needs EGL: a GPU, or
# Mesa's surfaceless platform (EGL_PLATFORM=surfaceless).
# Prove recording a video changes nothing.
check-video: build
    mkdir -p runs/video_check
    {{bin}} --scenario scenarios/explore.toml --seconds 3 --out runs/video_check/plain > /dev/null
    {{bin}} --scenario scenarios/explore.toml --seconds 3 --out runs/video_check/recorded \
        --video runs/video_check/recorded.mp4 --video-size 640x480 > runs/video_check/recorded.log
    grep -q "^recording " runs/video_check/recorded.log
    {{python}} {{tools}}/compare_run.py runs/video_check/recorded runs/video_check/plain

# An exploration that saves its map leaves a programmed image in the --flash file,
# and a new run boots from it to IDLE. The firmware saves when the exploration reaches
# the goal, at about 40 s on maze1.
# Prove the flash outlives a run.
check-flash: build
    rm -rf runs/flash && mkdir -p runs/flash
    {{bin}} --scenario scenarios/explore.toml --seconds 45 --out runs/flash/first --flash runs/flash/flash.bin > /dev/null
    {{python}} -c 'import sys; image = open("runs/flash/flash.bin", "rb").read(); sys.exit(0 if any(byte != 0xFF for byte in image) else "the flash image is blank")'
    {{bin}} --scenario scenarios/idle.toml --out runs/flash/second --flash runs/flash/flash.bin > /dev/null
    {{python}} {{tools}}/analyze.py runs/flash/second > /dev/null
    {{python}} {{tools}}/check_run.py --expect-state IDLE runs/flash/second

# The gate: tests, the window, video and bridge proofs, the checked runs, their health and the baseline.
check: build test check-viewer check-video check-monitor check-flash run-idle run-explore && compare-baseline
    for run in {{check_runs}}; do {{python}} {{tools}}/analyze.py runs/$run > /dev/null; done
    {{python}} {{tools}}/check_run.py --expect unbound_ports=0 --expect watchdog_expiries=0 \
        --expect emergency_stops=0 --expect serial_dropped_bytes=0 runs/idle runs/explore
