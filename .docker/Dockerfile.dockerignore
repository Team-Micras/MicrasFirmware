# BuildKit only reads ignore files at the context root or next to the Dockerfile with this name
.git/
.github/
.vscode/
.cache/
.idea/
build/
docs/*
!docs/*.md
cube/*
!cube/*.ioc

# The robot build needs only micras-lib's sources
external/micras-simulation/
external/*/.git
external/*/build/

.devcontainer.json
.gitignore
.gitmodules
LICENSE

*.yaml
*.md
*.iml
